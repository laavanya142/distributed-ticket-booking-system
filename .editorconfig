root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.java]
indent_style = space
indent_size = 4
tab_width = 4

[*.{xml,yml,yaml,json,md}]
indent_style = space
indent_size = 2
tab_width = 2

[*.sql]
indent_style = space
indent_size = 4

[*.sh]
indent_style = space
indent_size = 2
end_of_line = lf
